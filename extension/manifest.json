{
  "manifest_version": 3,
  "name": "Paws",
  "version": "0.1.2",
  "description": "Lets your local AI agents use this Chrome profile, through the Paws service on your Mac.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "downloads",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Paws"
  }
}
